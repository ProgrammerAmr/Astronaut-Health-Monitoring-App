# Copy to .env and configure values locally (never commit .env or real secrets)
#   Linux/macOS: cp .env.example .env
#   Windows    : copy .env.example .env
# Or run `npm run doctor -- --fix` inside backend/ to generate one automatically.
NODE_ENV=development
PORT=5000

# MongoDB. The default below is a local MongoDB (mongod / Docker mongo:7).
# Leave it empty and the backend falls back to this same local URI in development.
MONGO_URI=mongodb://127.0.0.1:27017/orbitcare

# JWT signing secret.
# The value below is an INSECURE placeholder that only exists so local login
# works out of the box. Replace it before any shared or deployed environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying-orbitcare

JWT_EXPIRES_IN=7d

# Optional SMTP configuration.
# When unset in development, OTP codes print to the backend console as
# "[DEVELOPMENT OTP] signup OTP for <email>: 123456" — you need that code to
# verify a new account before login is allowed.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# DEC-001 Cognitive State Monitoring (Python FastAPI service)
# Set via environment; never hardcoded in source (example: http://127.0.0.1:8000)
# Leave empty and the CSM endpoints safely report the service as unavailable.
CSM_AI_SERVICE_URL=http://127.0.0.1:8000
CSM_AI_TIMEOUT_MS=5000

# Optional override for local synthetic demo seed script (`npm run seed:demo`)
DEMO_USER_PASSWORD=
