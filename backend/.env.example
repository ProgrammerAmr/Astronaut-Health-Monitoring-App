# Copy to .env and configure values locally (never commit .env or real secrets)
NODE_ENV=development
PORT=5000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional SMTP configuration (in development, OTP is printed to backend stdout if unset)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# DEC-001 Cognitive State Monitoring (Python FastAPI service)
# Set via environment; never hardcoded in source (example: http://127.0.0.1:8001)
CSM_AI_SERVICE_URL=
CSM_AI_TIMEOUT_MS=5000

# Optional override for local synthetic demo seed script (`npm run seed:demo`)
DEMO_USER_PASSWORD=
