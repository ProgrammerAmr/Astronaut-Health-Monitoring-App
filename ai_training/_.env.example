# Copy to .env and edit. Every value is optional (defaults shown).
# Relative paths are resolved from where you start the process; absolute paths work too.
NASA_DOCS_DIR=./nasa_docs
CHROMA_DB_PATH=./chroma_db
THRESHOLDS_PATH=./thresholds.json
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
RAG_N_RESULTS=4
RAG_MAX_DISTANCE=1.2
LLM_TIMEOUT_SECONDS=90
# true = if no NASA source is found, return the safe fallback text instead of AI text
REQUIRE_GROUNDING=false
